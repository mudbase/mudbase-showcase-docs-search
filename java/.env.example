# Mudbase Showcase — Docs Search (Java / Spring Boot edition) - environment configuration
#
# This app reads configuration from real OS environment variables (see
# src/main/resources/application.properties for the property <-> env var mapping), not from a
# .env file directly - Spring Boot has no built-in .env loader. Export these before running, e.g.:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# or pass them via `-D...` / your process manager / container platform of choice.

# --- Mudbase project (required) ------------------------------------------------
# The project ID from the Mudbase dashboard. Public - not a secret.
MUDBASE_PROJECT_ID=6a6d3faad07caabbbdfc5698

# The two collections this app reads/writes, already provisioned with the field/permission
# shapes documented in ../web/plan/build-plan.md - the `customer` role (Mudbase's single default
# starter role) has full CRUD on both.
MUDBASE_DOCUMENTS_COLLECTION_ID=6a6d3fcdd07caabbbdfc5842
MUDBASE_SEARCH_LOG_COLLECTION_ID=6a6d3fcdd07caabbbdfc5857

# Mudbase API base URL. Only override for a self-hosted/staging Mudbase instance.
MUDBASE_URL=https://cloud.mudbase.dev

# --- Ask AI: Mudbase Function (required) --------------------------------------
# The deployed docsAskRetrieval Function's id (not a secret) and an org-scoped `ak_` API key with
# `functions` permission (SECRET - never commit a real value here). See
# ../web/plan/build-plan.md "Ask AI architecture" for why this key exists separately from the
# project's own `pk_` key: a project end-user JWT can only ever satisfy
# rbacCheck("functions","read"), never "create", which the /execute route requires.
MUDBASE_FUNCTION_ID=6a6d431ef09e238c3e62b2f4
MUDBASE_FUNCTIONS_API_KEY=

# --- Ask AI: LLM completion call (required for a real generated answer) -------
# Server-only. See README.md "LLM setup" for exactly how to obtain one. Left blank on purpose in
# this repo's own .env - Ask AI is fully wired up to the point of this call and fails with a
# clear "ANTHROPIC_API_KEY is not configured" error rather than a silent/fake success when unset.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- This app's own deployment ------------------------------------------------
# The port Spring Boot listens on.
PORT=8080

# Disable Thymeleaf template caching during local development so edits show up without a restart.
THYMELEAF_CACHE=false
