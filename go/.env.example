# ── Mudbase project (see plan/build-plan.md for the full collection/permission schema) ──
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d3faad07caabbbdfc5698
MUDBASE_DOCUMENTS_COLLECTION_ID=6a6d3fcdd07caabbbdfc5842
MUDBASE_SEARCH_LOG_COLLECTION_ID=6a6d3fcdd07caabbbdfc5857

# ── Ask AI: Mudbase Function invocation (server-only) ───────────────────────
# NEVER expose these client-side (this app has no client-side JS framework, so that risk is moot
# here, but the same rule applies as the reference web app's NEXT_PUBLIC_ convention). See
# README.md "Ask AI architecture" for exactly why an org-scoped API key is required instead of the
# signed-in visitor's own JWT: a project end-user JWT can only ever satisfy
# rbacCheck("functions","read"), never the "create" action the /execute route requires.
#
# MUDBASE_FUNCTION_ID: the _id of the deployed "docsAskRetrieval" Function in this project.
# MUDBASE_FUNCTIONS_API_KEY: an org-level API key (ak_ prefix) scoped to resource "functions"
#   with at least the "create" action - create one from the Mudbase dashboard's API Keys page for
#   this project's org, or via POST /api/api-keys with { "project": "<projectId>", "permissions":
#   [{ "resource": "functions", "actions": ["create","read"] }] } using an owner/admin/developer-
#   role account.
MUDBASE_FUNCTION_ID=6a6d431ef09e238c3e62b2f4
MUDBASE_FUNCTIONS_API_KEY=ak_d45285dd7616cbadf62d27575e70c5f45c33e5927935dd20

# ── Ask AI: LLM provider (Anthropic Claude) ─────────────────────────────────
# Never put this inside the Mudbase Function's own environment variables - the Function's sandbox
# has no network access (see README.md), so a key placed there would be unusable. Get a key from
# https://console.anthropic.com - see README.md "LLM setup" for the exact steps.
#
# Left blank on purpose in this checked-in example: no real Anthropic API key was available in the
# build/test environment this app was built and smoke-tested in. The Ask AI route is fully wired
# up to the point of this call (see internal/askai/llm.go) and fails with a clear
# "ANTHROPIC_API_KEY is not configured" error rather than a silent/fake success.
ANTHROPIC_API_KEY=
# Optional - defaults to claude-opus-5 if unset.
LLM_MODEL=claude-opus-5

# ── App/session config ───────────────────────────────────────────────────────
# Signs and encrypts the httpOnly session cookie holding the Mudbase JWT. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Set to "true" once this app is served over HTTPS in production - a Secure cookie is silently
# never sent over plain HTTP, which would break every page on local development.
COOKIE_SECURE=false

# Local HTTP listen port.
PORT=8080
