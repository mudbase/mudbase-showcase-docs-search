# ── Mudbase project (public — a project/collection ID is not a secret) ─────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
DOCUMENTS_COLLECTION_ID=
SEARCH_LOG_COLLECTION_ID=

# ── Server-only: Mudbase Function invocation (Ask AI retrieval ranking) ────
# NEVER expose these to a browser (this app never sends either to client JS anyway - it is
# fully server-rendered - but treat them with the same care as a real secret). See
# plan/build-plan.md "Ask AI architecture" for exactly why an org-scoped API key is required
# here instead of the signed-in user's own Mudbase JWT: a project end-user JWT can only ever
# satisfy rbacCheck("functions","read"), never the "create" action the /execute route requires.
#
# MUDBASE_FUNCTION_ID: the _id of the deployed "docsAskRetrieval" Function in this project.
# MUDBASE_FUNCTIONS_API_KEY: an org-level API key (ak_ prefix) scoped to resource "functions"
#   with at least the "create" action - create one from the Mudbase dashboard's API Keys page
#   for this project's org, or via POST /api/api-keys with { "project": "<projectId>",
#   "permissions": [{ "resource": "functions", "actions": ["create","read"] }] } using an
#   owner/admin/developer-role account.
MUDBASE_FUNCTION_ID=
MUDBASE_FUNCTIONS_API_KEY=

# ── Server-only: LLM provider (Anthropic Claude) ────────────────────────────
# Get a key from https://console.anthropic.com. Never put this inside the Mudbase Function's
# own environment variables - the Function's isolated-vm sandbox has no network access at all,
# so a key placed there would be unusable (see plan/build-plan.md "Ask AI architecture").
ANTHROPIC_API_KEY=
# Optional - defaults to claude-opus-5 if unset.
LLM_MODEL=claude-opus-5

# ── Session ──────────────────────────────────────────────────────────────
# Rack::Session::Cookie holds every Mudbase-issued JWT (real user + silent guest) server-side,
# inside an httponly, signed+encrypted cookie - client JS never touches it. Generate a long
# random value, e.g.: ruby -rsecurerandom -e "puts SecureRandom.hex(32)"
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=4567
RACK_ENV=development
