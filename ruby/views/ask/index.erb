<div class="space-y">
  <div>
    <h1 class="page-title">Ask AI</h1>
    <p class="page-subtitle">
      Ask a question in plain language. The app finds the most relevant documents in the library, then asks an
      LLM to answer strictly from their content — with citations back to the source documents.
    </p>
  </div>

  <div class="card">
    <h2 class="card-title">✨ Ask a question</h2>
    <form action="/ask" method="post" class="stack">
      <textarea name="question" rows="3" placeholder="e.g. How do I reset my password?" aria-label="Question for Ask AI" required><%= h(@question) %></textarea>
      <button type="submit" class="btn">Ask AI</button>
      <% if @ask_error %>
        <p class="flash flash-error" role="alert" style="margin:0;"><%= h(@ask_error) %></p>
      <% end %>
    </form>
  </div>

  <% if @no_match %>
    <p class="muted-note">
      No documents in the library matched that question closely enough to answer from. Try rephrasing, or add a
      document that covers it.
    </p>
  <% end %>

  <% if @answer %>
    <div class="card">
      <h2 class="card-title">Answer</h2>
      <p class="answer-text"><%= h(@answer) %></p>
      <% if @citations && @citations.any? %>
        <div>
          <p class="sources-label">Sources</p>
          <div class="tag-row">
            <% @citations.each do |citation| %>
              <a href="/documents/<%= h(citation[:documentId]) %>" class="badge badge-link"><%= h(citation[:title]) %> ↗</a>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @recent_searches && @recent_searches.any? %>
    <div>
      <p class="sources-label">🕘 Recent searches</p>
      <ul class="recent-list">
        <% @recent_searches.each do |entry| %>
          <li>
            <span class="recent-query"><%= h(entry[:queryText]) %></span>
            <span class="recent-meta">
              <%= entry[:resultCount] %> <%= entry[:resultCount] == 1 ? "source" : "sources" %> · <%= format_relative(entry[:createdAt]) %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
