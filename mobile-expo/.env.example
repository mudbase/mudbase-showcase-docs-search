# ── Mudbase project (public — a project/collection ID is not a secret) ─────
# Every value below is read client-side via EXPO_PUBLIC_* (Expo's convention for env vars that
# are safe to bundle into the app binary). Guests get a real anonymous-session JWT (see
# plan/build-plan.md "Auth model") so document reads and search resolve without forcing a login
# screen; creating/editing/deleting documents and using Ask AI still require a real signed-in
# account. There is no server-only secret anywhere in this app's own code — see the Ask AI proxy
# note below for the one exception this feature's architecture forces.
EXPO_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
EXPO_PUBLIC_MUDBASE_PROJECT_ID=
EXPO_PUBLIC_DOCUMENTS_COLLECTION_ID=
EXPO_PUBLIC_SEARCH_LOG_COLLECTION_ID=

# ── Ask AI proxy (optional — see plan/build-plan.md "Ask AI architecture") ──
# This mobile app has no server of its own, and the Ask AI feature's LLM completion call
# structurally cannot happen on-device (no API key may ever ship in the bundle) or inside the
# Mudbase Function (its isolated-vm sandbox has zero network access). The one real fix without
# inventing new infrastructure: point this at the sibling `../web` reference app's already-built,
# already-verified `POST /api/ask` Route Handler (run `npm run dev` in `../web` and use its origin,
# e.g. http://<your-lan-ip>:3000/api/ask for a physical device, or http://localhost:3000/api/ask
# for the web/simulator target) or at your own deployment of that same route. Leave unset to run
# this app with Ask AI honestly scoped out: the screen explains the gap instead of faking a call.
EXPO_PUBLIC_ASK_PROXY_URL=
