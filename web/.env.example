# ── Mudbase project (public — a project/collection ID is not a secret) ─────
NEXT_PUBLIC_MUDBASE_PROJECT_ID=
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
# Project-level publishable key (pk_ prefix). Safe to expose client-side — kept here for parity
# with the platform dashboard, but as of this build it is NOT accepted by any cloud.mudbase.dev
# auth middleware (authOrApiKey only recognizes X-API-Key/Authorization: Bearer values from the
# org-level API Keys feature, ak_-prefixed — a different mechanism from this project-level pk_
# field). Every client-side request in this app authenticates with a JWT instead (anonymous
# session for guests, real session after signup) — see src/lib/mudbase.ts.
NEXT_PUBLIC_MUDBASE_API_KEY=
NEXT_PUBLIC_DOCUMENTS_COLLECTION_ID=
NEXT_PUBLIC_SEARCH_LOG_COLLECTION_ID=

# ── Server-only: Mudbase Function invocation ────────────────────────────────
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side. See README.md "Ask AI
# architecture" for exactly why an org-scoped API key is required here instead of the signed-in
# user's own JWT.
#
# MUDBASE_FUNCTION_ID: the _id of the deployed "docsAskRetrieval" Function in this project.
# MUDBASE_FUNCTIONS_API_KEY: an org-level API key (ak_ prefix) scoped to resource "functions"
#   with at least the "create" action (required by the /execute route) — create one from the
#   Mudbase dashboard's API Keys page for this project's org, or via
#   POST /api/api-keys with { "project": "<projectId>", "permissions": [{ "resource":
#   "functions", "actions": ["create","read"] }] } using an owner/admin/developer-role account.
MUDBASE_FUNCTION_ID=
MUDBASE_FUNCTIONS_API_KEY=

# ── Server-only: LLM provider (Anthropic Claude) ────────────────────────────
# NEVER prefix this with NEXT_PUBLIC_ and never put it inside the Mudbase Function's own
# environment variables — the Function's sandbox has no network access (see README.md), so a
# key placed there would be unusable. Get a key from https://console.anthropic.com — see
# README.md "LLM setup" for the exact steps.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5 if unset.
LLM_MODEL=claude-opus-5
