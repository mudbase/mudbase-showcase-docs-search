@page
@model MudbaseShowcase.DocsSearch.Pages.VerifyEmailModel
@{
    ViewData["Title"] = "Email verification";
}

<div class="d-flex justify-content-center">
    <div class="w-100" style="max-width: 380px;">
        <div class="card">
            <div class="card-body text-center">
                <h1 class="h5 fw-semibold mb-2">Email verification</h1>

                @if (Model.Succeeded)
                {
                    <p class="text-success small mb-3">Your email is verified.</p>
                    <a class="btn btn-brand w-100" asp-page="/Login">Sign in now</a>
                }
                else
                {
                    <p class="text-danger small mb-0" role="alert">@Model.ErrorMessage</p>
                }
            </div>
        </div>
    </div>
</div>
