@using MudbaseShowcase.DocsSearch.Services
@inject MudbaseSessionAccessor SessionAccessor
@{
    MudbaseSessionUser? currentUser = SessionAccessor.CurrentUser;
    bool isSignedIn = currentUser is { IsSignedIn: true };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · Mudbase Docs Search" : "Mudbase Docs Search")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">Docs Search</a>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Ask">Ask AI</a>
                @if (isSignedIn)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Documents/New">New document</a>
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Login">Sign in</a>
                    <a class="btn btn-brand btn-sm" asp-page="/Register">Sign up</a>
                }
            </div>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container py-5 text-muted small border-top mt-5">
        Every document, search log entry, and Ask AI answer on this page is served by a real Mudbase
        project via the real Mudbase C# SDK, a deployed Mudbase Function for retrieval ranking, and a
        single server-side call to Anthropic's Claude API for the grounded completion — see the README
        for exactly why that one call can't live inside the Function itself. This is one of several
        per-language reimplementations of the same reference knowledge-base app.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
