@page
@model MudbaseShowcase.DocsSearch.Pages.IndexModel
@{
    ViewData["Title"] = "Document library";
}

<div class="mb-4">
    <h1 class="h4 fw-semibold mb-1">Document library</h1>
    <p class="text-muted small mb-0">
        Browse the knowledge base, or head to <a asp-page="/Ask">Ask AI</a> for a grounded answer synthesized from
        these documents.
    </p>
</div>

<form method="get" class="mb-4" style="max-width: 480px;">
    <div class="input-group">
        <span class="input-group-text" aria-hidden="true">&#128269;</span>
        <input type="text" name="Q" value="@Model.Q" class="form-control" placeholder="Search documents by title, content, or tag…" aria-label="Search documents" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.LoadError is not null)
{
    <p class="text-danger">@Model.LoadError</p>
}
else if (Model.Documents.Count == 0)
{
    <div class="border border-dashed rounded p-5 text-center text-muted">
        <p class="fw-medium mb-1">No documents match your search</p>
        <p class="small mb-0">Try a different keyword, or add the first document.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        @foreach (MudbaseShowcase.DocsSearch.Models.DocumentRecord document in Model.Documents)
        {
            <div class="col">
                <partial name="_DocumentCard" model="document" />
            </div>
        }
    </div>
}
