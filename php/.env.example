# ── Mudbase project (all required — see README "Setup") ────────────────────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
MUDBASE_DOCUMENTS_COLLECTION_ID=
MUDBASE_SEARCH_LOG_COLLECTION_ID=

# Project-level publishable key (pk_ prefix). Not currently sent on any request — see README
# "Known limitations": this backend's authOrApiKey middleware only recognizes ak_-prefixed org
# API keys, not this project-level pk_ field. Kept for parity with the platform dashboard;
# every request in this app authenticates with a JWT instead (anonymous session for guests, a
# real session after login/register).
MUDBASE_API_KEY=

# ── Server-only: Mudbase Function invocation (Ask AI retrieval step) ───────
# The project end-user JWT this app otherwise uses can only ever satisfy
# rbacCheck("functions","read"), never "create" — which the /execute route requires (org role is
# always "viewer" for a project end-user, confirmed against mudbase-backend source, see
# plan/build-plan.md "Ask AI architecture"). An org-scoped ak_ API key is required instead, and it
# must never be exposed to a browser — this app is server-rendered, so it never leaves this
# process except as an outbound request to cloud.mudbase.dev.
#
# MUDBASE_FUNCTION_ID: the _id of the deployed "docsAskRetrieval" Function in this project.
# MUDBASE_FUNCTIONS_API_KEY: an org-level API key (ak_ prefix) scoped to resource "functions"
#   with at least the "create" action (required by the /execute route) — create one from the
#   Mudbase dashboard's API Keys page for this project's org, or via
#   POST /api/api-keys with { "project": "<projectId>", "permissions": [{ "resource":
#   "functions", "actions": ["create","read"] }] } using an owner/admin/developer-role account.
MUDBASE_FUNCTION_ID=
MUDBASE_FUNCTIONS_API_KEY=

# ── Server-only: LLM provider (Anthropic Claude) ────────────────────────────
# The Mudbase Function's own isolated-vm sandbox has zero network access (no fetch, no
# http/https module — verified against the runner source, see plan/build-plan.md), so it cannot
# make this call itself. This app's own PHP request handler is the "smallest server-side
# surface" that makes the completion call instead — see plan/build-plan.md "Ask AI architecture".
# Get a key from https://console.anthropic.com — see README.md "LLM setup".
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5 if unset.
LLM_MODEL=claude-opus-5

# ── Session ──────────────────────────────────────────────────────────────────
# Name of the native PHP session cookie. Change only if it collides with another
# app on the same host/port during local development.
SESSION_NAME=mudbase_showcase_docs_search_php
