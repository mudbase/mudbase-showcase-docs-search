# ── Mudbase project ──────────────────────────────────────────────────────
# Same provisioned Mudbase project as the reference web/ app in this repo —
# see web/README.md "Provisioning" for what must already exist (local auth,
# Multi-Role with the default `customer` role, the two collections below,
# both granted create/read/update/delete to `customer`, plus the deployed
# `docsAskRetrieval` Function and its org-scoped API key).
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
DOCUMENTS_COLLECTION_ID=
SEARCH_LOG_COLLECTION_ID=

# ── Server-only: Mudbase Function invocation (retrieval ranking) ───────────
# See plan/build-plan.md "Ask AI architecture" for exactly why an org-scoped
# API key is required here instead of the signed-in user's own JWT (a
# project end-user's org role can never satisfy rbacCheck("functions",
# "create"), which the /execute route requires).
#
# MUDBASE_FUNCTION_ID: the _id of the deployed "docsAskRetrieval" Function
#   in this project.
# MUDBASE_FUNCTIONS_API_KEY: an org-level API key (ak_ prefix) scoped to
#   resource "functions" with at least the "create"/"read" actions — create
#   one from the Mudbase dashboard's API Keys page for this project's org.
MUDBASE_FUNCTION_ID=
MUDBASE_FUNCTIONS_API_KEY=

# ── Server-only: LLM provider (Anthropic Claude) ────────────────────────────
# Get a key from https://console.anthropic.com. Left blank here on purpose —
# every other part of the Ask AI pipeline (retrieval scoring, the real
# Function invocation, search logging) works with no key at all; only the
# final grounded-completion call needs one, and it fails there with a clear
# "ANTHROPIC_API_KEY is not configured" error rather than a fabricated
# answer. See app/services/llm.py and README.md "LLM setup".
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5 if unset.
LLM_MODEL=claude-opus-5

# ── Session cookie (server-only — never expose to the browser as JS) ───────
# Signs the itsdangerous/Starlette session cookie that holds the Mudbase JWT,
# refresh token, and user profile server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=mudbase_showcase_docs_search_session
# Set to "true" behind HTTPS in production so the session cookie is Secure.
SESSION_HTTPS_ONLY=false
